{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "./workers/app.ts",
  "name": "graycup-in-storefront",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": [
    // Enable Node.js API (Drizzle/Neon serverless driver need this)
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Populate process.env from Worker bindings/secrets (needed since src/lib/db.ts reads process.env.DATABASE_URL)
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat_populate_process_env",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "graycup-orders",
      "database_id": "c761625d-96b2-40a9-b1a3-4d9a58cae436",
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "vars": {
    "SITE_URL": "https://graycup.in",
  },
}
