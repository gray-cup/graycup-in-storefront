{
  "name": "graycup-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "generate:og": "tsx scripts/generate-og-images.ts",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "fetch:guide-images": "tsx scripts/fetch-guide-images.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env scripts/apply-migrations.mjs",
    "prebuild": "npm run generate:og",
    "build": "react-router build && npm run generate:sitemap",
    "start": "wrangler dev",
    "format": "prettier --write .",
    "prepare": "husky",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "react-router typegen && tsc -b",
    "cf-typegen": "wrangler types --env-interface Env worker-configuration.d.ts"
  },
  "dependencies": {
    "@cashfreepayments/cashfree-js": "^1.0.7",
    "@cloudflare/vite-plugin": "^1.52.1",
    "@hookform/resolvers": "^5.5.7",
    "@intercom/messenger-js-sdk": "^0.0.18",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-router/cloudflare": "^8.3.0",
    "@react-router/dev": "^8.3.0",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.43.0",
    "gray-matter": "^4.0.3",
    "isbot": "^5",
    "knip": "^5.88.1",
    "lucide-react": "^0.562.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-icons": "^5.7.0",
    "react-router": "^8.3.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "resend": "^6.18.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "use-webmcp-tool": "^0.2.0",
    "vite": "^8.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "playwright": "^1.62.1",
    "prettier": "3.6.2",
    "satori": "^0.29.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "wrangler": "^4.120.0"
  }
}
